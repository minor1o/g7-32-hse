<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="ru-RU">
  <info>
    <title>Russian GOST R 7.0.5-2008 (Foreign-First Edition)</title>
    <id>http://www.zotero.org/styles/gost-r-7-0-5-2008-vkr-foreign-first</id>
    <link href="http://www.zotero.org/styles/gost-r-7-0-5-2008-vkr-foreign-first" rel="self"/>
    <author><name>Antigravity</name></author>
    <category citation-format="numeric"/>
    <updated>2026-04-25T13:40:00+00:00</updated>
  </info>

  <locale xml:lang="ru">
    <terms>
      <term name="et-al"> и др.</term>
      <term name="editor">под ред.</term>
      <term name="accessed">дата обращения</term>
      <term name="page" form="short">С.</term>
    </terms>
  </locale>

  <locale xml:lang="en">
    <terms>
      <term name="et-al"> et al.</term>
      <term name="page" form="short">С.</term>
    </terms>
  </locale>

  <macro name="author-heading">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " et-al-min="2" et-al-use-first="1"/>
    </names>
  </macro>

  <macro name="author-resp">
    <names variable="author" delimiter=", ">
      <name initialize-with=". " delimiter=", " et-al-min="100" et-al-use-first="99"/>
    </names>
  </macro>

  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=", ">
          <group delimiter=": ">
            <text value="Режим доступа"/>
            <text variable="URL"/>
          </group>
          <choose>
            <if variable="abstract">
              <text variable="abstract"/>
            </if>
            <else>
              <text value="свободный"/>
            </else>
          </choose>
        </group>
        <group prefix=". (" suffix=")">
          <text term="accessed" suffix=": "/>
          <date variable="accessed">
            <date-part name="day" suffix="." form="numeric-leading-zeros"/>
            <date-part name="month" suffix="." form="numeric-leading-zeros"/>
            <date-part name="year"/>
          </date>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="language-sort">
    <choose>
      <if variable="note">
        <text variable="note"/>
      </if>
      <else>
        <text value="2"/>
      </else>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="100" et-al-use-first="99" entry-spacing="1">
    <sort>
      <key macro="language-sort"/>
      <key macro="author-heading"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". — ">
        <group>
          <group delimiter=". ">
            <group delimiter=" ">
              <text variable="citation-number" suffix="."/>
              <text macro="author-heading"/>
            </group>
            <group delimiter=" ">
              <text variable="title"/>
              <choose>
                <if variable="URL">
                  <text value="[Электронный ресурс]"/>
                </if>
              </choose>
            </group>
          </group>
          <group prefix=" / " delimiter=" ; ">
            <choose>
              <if variable="author">
                <text macro="author-resp"/>
              </if>
            </choose>
          </group>
          <choose>
            <if variable="container-title">
              <group prefix=" // " delimiter=" — ">
                <group delimiter=" : ">
                  <text variable="container-title"/>
                  <group delimiter=" : ">
                    <text variable="publisher-place"/>
                    <text variable="publisher"/>
                  </group>
                </group>
              </group>
            </if>
          </choose>
        </group>

        <choose>
          <if variable="container-title">
            <date variable="issued"><date-part name="year"/></date>
            <group delimiter=" ">
              <label variable="page" form="short"/>
              <text variable="page"/>
            </group>
          </if>
          <else>
            <group delimiter=", ">
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
              <date variable="issued"><date-part name="year"/></date>
            </group>
            <choose>
              <if variable="page">
                <group delimiter=" ">
                  <label variable="page" form="short"/>
                  <text variable="page"/>
                </group>
              </if>
              <else-if variable="number-of-pages">
                <group delimiter=" ">
                  <text variable="number-of-pages"/>
                  <text value="с."/>
                </group>
              </else-if>
            </choose>
          </else>
        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
